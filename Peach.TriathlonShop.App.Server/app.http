# For more info on HTTP files go to https://aka.ms/vs/httpfile


@baseUrl = http://localhost:5089/api


#############
### Stock ###
#############

GET {{baseUrl}}/stock/all-warehouses


### Articles

GET {{baseUrl}}/stock/articles?articleName=&pageNumber=1&pageSize=10&sortKey=ArticleNumber&sortDirection=Asc


##############
### Orders ###
##############

### Create order (200 OK with no response body)

POST {{baseUrl}}/orders
Content-Type: application/json

{
  "customerId": 1,
  "orderRows": [
    {
      "articleId": 1,
      "quantity": 1
    }
  ]
}

### Set order confirm

POST {{baseUrl}}/orders/confirm/1
Content-Type: application/json
{}

