<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <SpaRoot>..\peach.triathlonshop.app.client</SpaRoot>
    <SpaProxyLaunchCommand>npm run dev</SpaProxyLaunchCommand>
    <SpaProxyServerUrl>https://localhost:56199</SpaProxyServerUrl>
    <UserSecretsId>5f13a35f-06ef-438e-b1f6-f65ff870dfaa</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Messaging.ServiceBus" Version="7.21.0" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />
    <PackageReference Include="Microsoft.AspNetCore.SpaProxy">
      <Version>10.*-*</Version>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\peach.triathlonshop.app.client\peach.triathlonshop.app.client.esproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
    </ProjectReference>
    <ProjectReference Include="..\Peach.TriathlonShop.Database\Peach.TriathlonShop.Database.csproj" />
    <ProjectReference Include="..\Peach.TriathlonShop.FunctionApp.Client\Peach.TriathlonShop.FunctionApp.Client.csproj" />
    <ProjectReference Include="..\Peach.TriathlonShop.ServiceBus.Client\Peach.TriathlonShop.ServiceBus.Client.csproj" />
  </ItemGroup>

</Project>
