# For more info on HTTP files go to https://aka.ms/vs/httpfile


@baseUrl = http://localhost:7285/api


#################
### Dashboard ###
#################

GET {{baseUrl}}/dashboard
Accept: application/json


###

##############
### Orders ###
##############

### Id
GET {{baseUrl}}/orders?id=12&includeOrderRows=true&includeCustomer=true
Accept: application/json

### Order status

GET {{baseUrl}}/orders?orderStatus=created&orderStatus=confirmed
Accept: application/json


### Search by destination location

GET {{baseUrl}}/orders?destinationLocation=ra
Accept: application/json



### Update order
PUT {{baseUrl}}/orders/45
Content-Type: application/json
{
  "AddOrderRows": [
    {
      "ArticleId": 63,
      "Quantity": 3
    },
    {
      "ArticleId": 21,
      "Quantity": 8
    }
  ]
}

#################
### Developer ###
#################

### Random orders

# @timeout 600
POST {{baseUrl}}/developer/orders/random
Content-Type: application/json
{
  "OrdersCountIntervalStart": 100,
  "OrdersCountIntervalEnd": 100,
  "ArticlesCountIntervalStart": 1,
  "ArticlesCountIntervalEnd": 10,
  "QuantityIntervalStart": 1,
  "QuantityIntervalEnd": 10,
  "ContinentName": "Europe",
  "UseRandomOrderStatus": false,
  "UseRandomPlacedDate": true,
  "UseRandomDelay": false,
  "DelayMsIntervalStart": 0,
  "DelayMsIntervalEnd": 3000
}


### Create random articles

POST {{baseUrl}}/developer/articles/random
Content-Type: application/json
{
  "ArticlesCount": 20,
  "UnitPriceIntervalStart": 1,
  "UnitPriceIntervalEnd": 200
}


### Set random cities
POST {{baseUrl}}/developer/cities/random
Content-Type: application/json
{
}


### SignalR test

POST {{baseUrl}}/developer/signalr/{hubName}/{eventName}
Content-Type: application/json
{
  "Message": "hello world",
  "Update": true,
  "Timestamp": "2026-10-17T12:34:33Z"
}



### developer/warehouse/ship-to-country
POST {{baseUrl}}/developer/warehouse/ship-to-country
Content-Type: application/json
{}


### developer/warehouse/main
POST {{baseUrl}}/developer/warehouses/main
Content-Type: application/json
{}


### Random stock items
POST {{baseUrl}}/developer/warehouses/random-stock-items
Content-Type: application/json
{
  "ContinentName": "Europe"
}



#############
### Stock ###
#############



### stock/overview
GET {{baseUrl}}/stock/overview
Accept: application/json



### Get stock

GET {{baseUrl}}/stock/all-warehouses
Accept: application/json


### Get articles
GET {{baseUrl}}/stock/articles
Accept: application/json



#################
### Transport ###
#################


### Transport order accepted

POST {{baseUrl}}/transport-order/accepted/TR-93d1ac37-85fc-4278-8fc1-806ed0b4ed29
Content-Type: application/json
{
  "ConsignmentNumber": "TR-93d1ac37-85fc-4278-8fc1-806ed0b4ed29",
  "Destination": "Chokladfabriken 1, 12345 Nordpolen",
  "TrackingUrl": "someUrl",
  "EstimatedDeliveryDate": "2027-06-01T12:00:00Z",
  "Timestamp": "2026-10-17T12:34:33Z"
}


### Set order confirm

POST {{baseUrl}}/order/21/confirm
Content-Type: application/json
{
}


### SignalR negotiation

GET {{baseUrl}}/negotiation/homepage
Content-Type: application/json
{
}
